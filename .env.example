# Database Configuration
DB_URL=jdbc:postgresql://main-db:5435/orbenox
DB_USERNAME=postgres
DB_PASSWORD=postgres

STOCK_DB_URL=jdbc:postgresql://stock-db:5436/stock
STOCK_DB_USERNAME=postgres
STOCK_DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080

# Active Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

EUREKA_SERVICE_PORT=8761
EUREKA_DEFAULT_ZONE=http://eureka-service:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true

API_GATEWAY_PORT=8080

# Auth0 machine-to-machine application and stock-service API identifier
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_STOCK_SERVICE_AUDIENCE=https://your-stock-service-api
